{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
            }
        },
        "WriteTo": [ { "Name": "Console" } ],
        "Enrich": [ "FromLogContext" ]
    },
    "ConnectionStrings": {
        "_comment": "Buraya gercek deger YAZILMAZ. Gelistirmede 'dotnet user-secrets', production'da ConnectionStrings__ServerGuard ortam degiskeni kullanilir. Bkz. README.",
        "ServerGuard": ""
    },
    "Cors": {
        "AllowedOrigins": [ "http://localhost:4200" ]
    },
    "Detection": {
        "BruteForce": {
            "Enabled": true,
            "FailureThreshold": 5,
            "Window": "00:05:00",
            "TrackedIpLimit": 50000
        },
        "TrafficAnomaly": {
            "Enabled": true,
            "RequestThreshold": 100,
            "Window": "00:01:00",
            "AlertCooldown": "00:05:00",
            "BucketCount": 6,
            "IdleRetention": "01:00:00",
            "CleanupInterval": "00:05:00",
            "TrackedIpLimit": 100000
        }
    },
    "AllowedHosts": "*"
}
