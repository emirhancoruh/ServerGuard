<?xml version="1.0" encoding="utf-8"?>
<!--
  Angular panelinin IIS sitesi icin yapilandirma.

  Bu site statik dosya sunar; icinde .NET calismaz, uygulama havuzu "Yonetilen Kod Yok"
  olmalidir. API ayri bir sitede oldugundan guvenlik header'lari burada, IIS tarafinda
  eklenir - API'nin middleware'i bu yanitlara dokunmaz.

  KURULUMDA DEGISTIRILECEK TEK YER: asagidaki Content-Security-Policy satirindaki
  connect-src. API'nin adresi oraya yazilmalidir, yoksa panel API'ye hic istek atamaz.
-->
<configuration>
  <system.webServer>

    <httpProtocol>
      <customHeaders>
        <!-- Sunucu hakkinda bilgi sizdirmaz. -->
        <remove name="X-Powered-By" />

        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Permissions-Policy" value="geolocation=(), camera=(), microphone=(), payment=()" />

        <!--
          connect-src icindeki API adresini kendi kurulumunuza gore degistirin.
          Hem https/http hem de ws/wss adresi yazilir: SignalR canli baglantisi WebSocket
          kullanir ve bazi tarayicilar bunu ayrica ister.

          Ornek (HTTP, port):  connect-src 'self' http://sunucu10:8091 ws://sunucu10:8091;
          Ornek (HTTPS, ad):   connect-src 'self' https://api.ornek.local wss://api.ornek.local;

          style-src satir ici stile izin verir: Angular ve DevExtreme calisma zamaninda
          stil enjekte eder. Script icin boyle bir izin verilmez.
        -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' http://SUNUCU10:8091 ws://SUNUCU10:8091; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!--
        Once remove, sonra mimeMap: tur sunucu genelinde zaten tanimliysa cift tanim
        hatasi (500.19) olusmasin diye. woff2 eski IIS surumlerinde tanimli degildir ve
        eksik oldugunda DevExtreme ikon yazi tipi 404 doner.
      -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
    </staticContent>

    <rewrite>
      <rules>
        <!--
          Angular yonlendirmesi istemci tarafindadir. Kullanici dogrudan /reports adresine
          giderse IIS'te boyle bir dosya yoktur ve 404 doner; istek index.html'e dusurulur,
          gerisini Angular halleder.

          Kosullar sayesinde gercekten var olan dosya ve klasorler etkilenmez: main-*.js,
          styles-*.css ve config.json dogrudan servis edilmeye devam eder.
        -->
        <rule name="Angular yonlendirmesi" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>

  <!--
    Bu iki dosya onbellege alinmamalidir. Adi degismeyen dosyalardir: panel
    guncellendiginde tarayici eskisini kullanmaya devam ederse kullanici yeni surumu
    gormez. Adinda karma bulunan dosyalar (main-XXXX.js) bundan etkilenmez.
  -->
  <location path="config.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
